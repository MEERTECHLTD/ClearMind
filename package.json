{
  "name": "clearmind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-clearmind \"vitest run --config vitest.rules.config.ts\"",
    "deploy:web": "vite build && cd apps/mobile && eas deploy --export-dir ../../dist --prod",
    "deploy:web:preview": "vite build && cd apps/mobile && eas deploy --export-dir ../../dist",
    "build:agent": "node scripts/build-agent.mjs",
    "test:e2e:agent": "node scripts/e2e-agent.mjs",
    "test:e2e:web": "vite build && playwright test -c e2e/web"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@google/genai": "^1.33.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "dompurify": "^3.4.16",
    "expo-router": "~5.1.11",
    "firebase": "^12.7.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.561.0",
    "marked": "^18.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.29",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "babel-preset-expo": "13.2.5",
    "react-native-css-interop": "0.1.22"
  }
}
