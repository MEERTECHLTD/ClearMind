rules_version = '2';

// ClearMind Firestore security rules.
//
//   users/{uid}/…        — personal local-first data; strictly the owner.
//   workspaces/{wsId}    — shared, collaborative Applications workspaces.
//   workspaces/{wsId}/applications/{appId} — the shared applications.
//
// Membership is by EMAIL: the auth token carries `email`, so the owner can invite
// someone just by adding their email to memberEmails — no uid lookup needed. Every
// member has full read/write on the applications (no viewer/editor roles).
//
// Deploy:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Personal data: strictly the signed-in owner ----
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Shared, collaborative workspaces ----
    function isWsMember(ws) {
      return request.auth != null && (
        request.auth.uid == ws.ownerUid ||
        (request.auth.token.email != null && request.auth.token.email in ws.memberEmails)
      );
    }

    match /workspaces/{wsId} {
      allow read: if isWsMember(resource.data);

      // Owner is identified by uid (robust to email casing). The client seeds
      // memberEmails with the owner's (normalized) email so the list query finds it.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      // Owner can update freely; ownership is immutable.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // JOIN VIA LINK: any signed-in user may add ONLY their own email to the member
      // list (nothing else but updatedAt changes). This is the "anyone with the link
      // can join" capability — the workspace id is an unguessable token.
      allow update: if request.auth != null
        && request.auth.token.email != null
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.name == resource.data.name
        && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
        && request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1
        && request.auth.token.email in request.resource.data.memberEmails
        && !(request.auth.token.email in resource.data.memberEmails);

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;

      // Applications inside a workspace: any member has full read/write.
      match /applications/{appId} {
        allow read, write: if isWsMember(
          get(/databases/$(database)/documents/workspaces/$(wsId)).data
        );
      }
    }
  }
}
